# Resend settings for the email studio.
#
# How to use:
#   1. Copy this file to .env in the project folder (same folder as this file).
#        Windows (PowerShell):  Copy-Item .env.example .env
#        Mac (Terminal):        cp .env.example .env
#   2. Fill in the values below in .env. Never put real values in this file.
#   3. Quit the Claude app fully and open it again, so the Resend server restarts.
#
# .env is git-ignored, so your key stays on your computer.
# Leave a value empty (or delete .env) to use practice mode for it.
# A real environment variable with the same name wins over .env.
#
# Check which mode you're in at any time:
#   node .claude/mcp/resend-launch.mjs --check

# Your Resend API key. Use a "Sending access" key limited to your domain.
# Practice default: a placeholder key.
RESEND_API_KEY=

# Where requests go. For live sending use https://api.resend.com
# Practice default: http://localhost:4000 (a local practice server; nothing leaves your computer).
RESEND_BASE_URL=

# The "from" address. Must be on a domain you've verified in Resend.
# Practice default: onboarding@resend.dev
SENDER_EMAIL_ADDRESS=

# Your own email address. The send guard lets email go to this address
# and to @resend.dev test addresses, and blocks everything else.
# Leave empty to allow @resend.dev addresses only.
# Changes take effect on the next send; no restart needed.
MY_EMAIL=
